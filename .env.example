# Ghost API Hunter Configuration

# Target Configuration
TARGET=https://vulnbank.org
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=10
RETRY_ATTEMPTS=3
RATE_LIMIT_DELAY=0.5

# LLM Configuration (Groq - Free tier with Llama 3.1 70B)
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=

# Alternative: Google Gemini (https://aistudio.google.com)
# GOOGLE_API_KEY=

# Output Configuration
OUTPUT_DIR=output
REPORT_FORMAT=both
