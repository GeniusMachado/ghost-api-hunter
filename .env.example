# Configuration for API discovery and classification

TARGET=https://vulnbank.org
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=10
RETRY_ATTEMPTS=3
RATE_LIMIT_DELAY=0.5

# Gemini API key for LLM classification
# Get free key from https://aistudio.google.com
GEMINI_API_KEY=your_api_key_here

# Output settings
OUTPUT_DIR=output
REPORT_FORMAT=both
